# API configuration placeholders for the P05-api starter.
#
# PENTING:
# - Flutter TIDAK membaca file .env ini secara native. Nilai dipakai lewat
#   `--dart-define` saat build/run (lihat p05-api/README.md dan API-CONTRACT.md).
# - File ini hanya dokumentasi placeholder. JANGAN isi dengan rahasia nyata
#   lalu commit.
#
# Contoh pemakaian:
#   flutter run \
#     --dart-define=API_BASE_URL=https://your-server.example.com \
#     --dart-define=API_TOKEN=replace-me

API_BASE_URL=
API_TOKEN=
